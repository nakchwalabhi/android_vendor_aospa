<manifest>
  <!-- AOSPA uses lahaina.xml for Motorola holi/sm7325-class devices (see dubai). -->
  <include name="../platforms/lahaina.xml" />

  <!-- Converted AOSPA device + common trees. -->
  <project path="device/motorola/fogos"          name="nakchwalabhi/android_device_motorola_fogos-aospa"          remote="github" revision="aospa" />
  <project path="device/motorola/sm6375-common"  name="nakchwalabhi/android_device_motorola_sm6375-common-aospa"  remote="github" revision="aospa" />


  <!-- Motorola hardware (MotoActions, MotoCommonOverlay, sepolicy). -->
  <project path="hardware/motorola"              name="nakchwalabhi/android_hardware_motorola"                   remote="github" revision="aospa" />

  <!-- NFC: fogos uses the Samsung SLSI NFC HAL. -->
  <project path="hardware/samsung_slsi/nfc"      name="LineageOS/android_hardware_samsung_slsi_nfc"              remote="github" revision="lineage-23.0" />

  <!-- Vendor blobs (existing repos). -->
  <project path="vendor/motorola/fogos"          name="nakchwalabhi/proprietary_vendor_motorola_fogos"           remote="github" revision="aospa"  clone-depth="1" />
  <project path="vendor/motorola/sm6375-common"  name="nakchwalabhi/proprietary_vendor_motorola_sm6375-common"   remote="github" revision="beryl"  clone-depth="1" />
</manifest>
